<Window x:Class="AssetManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        Title="Asset Manager" Width="1480" Height="800" MinWidth="1000" MinHeight="460"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.WindowText}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="8" LastChildFill="True">
            <Button DockPanel.Dock="Left" Content="Add folder…" Command="{Binding AddFolderCommand}"
                    Padding="12,4" Margin="0,0,6,0"/>
            <Button DockPanel.Dock="Left" Content="Rescan all" Command="{Binding RescanCommand}"
                    Padding="12,4" Margin="0,0,12,0"/>
            <Button DockPanel.Dock="Right" Width="34" Margin="6,0,0,0" Padding="0"
                    Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeToolTip}"
                    FontFamily="Segoe MDL2 Assets" FontSize="16">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Content" Value="&#xE708;"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                <Setter Property="Content" Value="&#xE706;"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <ComboBox DockPanel.Dock="Right" Width="130" Margin="6,0,0,0"
                      ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}"
                      DisplayMemberPath="Label"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" ToolTip="Search by file name, path or tag"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="170" MaxWidth="500"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="330" MinWidth="240" MaxWidth="560"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Grid.Column="0" Margin="8,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" MinHeight="40"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="LIBRARY" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextMuted}" Margin="4,0,0,4"/>

                <TreeView Grid.Row="1" ItemsSource="{Binding Folders}" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                          AllowDrop="True" DragOver="Folders_DragOver" Drop="Folders_Drop">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <DockPanel LastChildFill="True" Margin="0,1" ToolTip="{Binding FullPath}"
                                       ContextMenuService.IsEnabled="{Binding HasMenu}"
                                       Background="Transparent" AllowDrop="True"
                                       DragEnter="Node_DragEnter" DragOver="Node_DragOver"
                                       DragLeave="Node_DragLeave" Drop="Node_Drop">
                                <Button DockPanel.Dock="Right" Content="+" Width="20" Height="20" Padding="0"
                                        Margin="4,0,0,0" ToolTip="New bundle" Command="{Binding NewBundleCommand}"
                                        Visibility="{Binding IsBundleGroupKind, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat={}{0:N0}}"
                                           Foreground="{DynamicResource Brush.TextFaint}" Margin="12,0,4,0"/>
                                <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.PlaceholderText}"/>
                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <DockPanel.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Rescan" Command="{Binding RescanCommand}"
                                                  Visibility="{Binding IsFolderKind, Converter={StaticResource BoolToVisibility}}"/>
                                        <MenuItem Header="Show in Explorer" Command="{Binding OpenInExplorerCommand}"
                                                  Visibility="{Binding IsFolderKind, Converter={StaticResource BoolToVisibility}}"/>
                                        <MenuItem Header="Mark all as my creations" Command="{Binding MarkAsMineCommand}"
                                                  Visibility="{Binding IsFolderKind, Converter={StaticResource BoolToVisibility}}"/>
                                        <MenuItem Header="Remove the ‘mine’ mark" Command="{Binding UnmarkMineCommand}"
                                                  Visibility="{Binding IsFolderKind, Converter={StaticResource BoolToVisibility}}"/>
                                        <MenuItem Header="Remove from library…" Command="{Binding RemoveCommand}"
                                                  Visibility="{Binding IsFolderKind, Converter={StaticResource BoolToVisibility}}"/>
                                        <MenuItem Header="Delete tag…" Command="{Binding DeleteTagCommand}"
                                                  Visibility="{Binding IsTagKind, Converter={StaticResource BoolToVisibility}}"/>
                                        <MenuItem Header="Export as zip…" Command="{Binding ExportBundleCommand}"
                                                  Visibility="{Binding IsBundleKind, Converter={StaticResource BoolToVisibility}}"/>
                                        <MenuItem Header="Rename…" Command="{Binding RenameBundleCommand}"
                                                  Visibility="{Binding IsBundleKind, Converter={StaticResource BoolToVisibility}}"/>
                                        <MenuItem Header="Delete bundle…" Command="{Binding DeleteBundleCommand}"
                                                  Visibility="{Binding IsBundleKind, Converter={StaticResource BoolToVisibility}}"/>
                                        <MenuItem Header="New bundle…" Command="{Binding NewBundleCommand}"
                                                  Visibility="{Binding IsBundleGroupKind, Converter={StaticResource BoolToVisibility}}"/>
                                    </ContextMenu>
                                </DockPanel.ContextMenu>
                            </DockPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <DockPanel Grid.Row="2" Margin="4,12,0,4" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="+" Width="22" Height="20" Padding="0"
                            Command="{Binding AddTargetCommand}" ToolTip="Add a copy target (e.g. your Godot project)"/>
                    <TextBlock Text="QUICK TARGETS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <Grid Grid.Row="3">
                    <ListBox ItemsSource="{Binding QuickTargets}" MaxHeight="230" BorderThickness="1"
                             BorderBrush="{DynamicResource Brush.Border}" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2" LastChildFill="True" ToolTip="{Binding TargetPath}"
                                           Background="Transparent" AllowDrop="True"
                                           DragEnter="Target_DragEnter" DragOver="Target_DragOver"
                                           DragLeave="Target_DragLeave" Drop="Target_Drop">
                                    <Button DockPanel.Dock="Right" Content="Copy here" Padding="8,2" Margin="6,0,0,0"
                                            VerticalAlignment="Center" Command="{Binding CopySelectionCommand}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                                    </StackPanel>
                                    <DockPanel.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Sort into subfolders by type" IsCheckable="True"
                                                      IsChecked="{Binding SortByType, Mode=TwoWay}"/>
                                            <MenuItem Header="snake_case file names" IsCheckable="True"
                                                      IsChecked="{Binding SnakeCaseNames, Mode=TwoWay}"/>
                                            <Separator/>
                                            <MenuItem Header="Remove target" Command="{Binding RemoveCommand}"/>
                                        </ContextMenu>
                                    </DockPanel.ContextMenu>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Add a folder (e.g. your Godot project) to copy selected assets into it with one click."
                               TextWrapping="Wrap" Margin="6,4" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding QuickTargets.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <!-- Virtualized thumbnail grid -->
            <ListBox Grid.Column="2" Margin="0,0,0,8"
                     ItemsSource="{Binding Items}" SelectionMode="Extended"
                     SelectionChanged="Grid_SelectionChanged"
                     PreviewMouseMove="Grid_PreviewMouseMove"
                     PreviewMouseLeftButtonUp="Grid_PreviewMouseLeftButtonUp"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.InputBindings>
                    <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyFilesCommand}"/>
                    <KeyBinding Key="C" Modifiers="Ctrl+Shift" Command="{Binding CopyPathsCommand}"/>
                    <KeyBinding Key="Return" Command="{Binding OpenSelectedCommand}"/>
                </ListBox.InputBindings>

                <ListBox.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Copy files" InputGestureText="Ctrl+C" Command="{Binding CopyFilesCommand}"/>
                        <MenuItem Header="Copy path" InputGestureText="Ctrl+Shift+C" Command="{Binding CopyPathsCommand}"/>
                        <MenuItem Header="Copy to" ItemsSource="{Binding QuickTargets}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="{Binding Name}"/>
                                    <Setter Property="Command" Value="{Binding CopySelectionCommand}"/>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Add to bundle" ItemsSource="{Binding BundleMenuItems}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="{Binding Header}"/>
                                    <Setter Property="Command" Value="{Binding Command}"/>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <MenuItem Header="Remove from this bundle" Command="{Binding RemoveFromBundleCommand}"
                                  Visibility="{Binding IsBundleSelected, Converter={StaticResource BoolToVisibility}}"/>
                        <MenuItem Header="Export selection as zip…" Command="{Binding ExportSelectionCommand}"/>
                        <Separator/>
                        <MenuItem Header="Show in Explorer" Command="{Binding ShowInExplorerCommand}"/>
                        <MenuItem Header="Open" InputGestureText="Enter" Command="{Binding OpenSelectedCommand}"/>
                    </ContextMenu>
                </ListBox.ContextMenu>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel ItemSize="170,200"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Item_PreviewMouseLeftButtonDown"/>
                        <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick"/>
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="Item_RightClick"/>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="160" Height="190" Margin="5" CornerRadius="4"
                                BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.TileBackground}"
                                ToolTip="{Binding RelativePath}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="4" Background="{DynamicResource Brush.ThumbBackground}">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding Extension}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.PlaceholderText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- favorite star: faint on hover, solid gold when favorited -->
                                    <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3"
                                            Width="24" Height="24" Padding="0" BorderThickness="0"
                                            Background="{DynamicResource Brush.StarBackground}" Cursor="Hand" ToolTip="Favorite"
                                            Command="{Binding ToggleFavoriteCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock FontSize="15" Text="☆" Foreground="{DynamicResource Brush.StarOff}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Text" Value="★"/>
                                                            <Setter Property="Foreground" Value="#E0A100"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>

                                    <!-- license badge, colored by how restrictive the license is -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                            Padding="5,1" CornerRadius="3" ToolTip="{Binding LicenseTooltip}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.BadgeNeutral}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LicenseBadgeText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LicenseRiskKey}" Value="Free">
                                                        <Setter Property="Background" Value="#2E7D32"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LicenseRiskKey}" Value="Conditions">
                                                        <Setter Property="Background" Value="#B26A00"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LicenseRiskKey}" Value="Restricted">
                                                        <Setter Property="Background" Value="#C62828"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding LicenseBadgeText}" Foreground="White"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                    </Border>

                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4"
                                            Padding="5,1" CornerRadius="3" Background="#1565C0"
                                            Visibility="{Binding IsOwn, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="MINE" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="6,2">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <!-- Inspector: favorite/mine, tags, license conditions and readme -->
            <ScrollViewer Grid.Column="4" Margin="0,0,8,8" VerticalScrollBarVisibility="Auto"
                          DataContext="{Binding Inspector}" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <TextBlock Text="Select an asset to see its details, tags, license and readme."
                               TextWrapping="Wrap" Margin="10" Foreground="{DynamicResource Brush.TextMuted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Margin="4,0,0,0"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">

                        <Image Source="{Binding Primary.Thumbnail}" Height="200" Stretch="Uniform" Margin="0,0,0,8"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding IsSingle, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                                   TextWrapping="Wrap" Margin="0,2,0,8"/>

                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="{Binding FavoriteText}" Command="{Binding ToggleFavoriteCommand}"
                                    Padding="10,4" Margin="0,0,6,0"/>
                            <Button Content="{Binding OwnText}" Command="{Binding ToggleOwnCommand}"
                                    Padding="10,4"/>
                        </WrapPanel>

                        <!-- Tags -->
                        <TextBlock Text="TAGS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.Chip}" CornerRadius="10" Padding="8,2,2,2" Margin="0,0,4,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                            <Button Content="×" Command="{Binding RemoveCommand}" Background="Transparent"
                                                    BorderThickness="0" Padding="5,0" Margin="2,0,0,0" Cursor="Hand"
                                                    ToolTip="Remove tag"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ComboBox IsEditable="True" ItemsSource="{Binding KnownTagNames}"
                                  Text="{Binding NewTagText, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Type a tag and press Enter. Separate several with commas.">
                            <ComboBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddTagCommand}"/>
                            </ComboBox.InputBindings>
                        </ComboBox>
                        <TextBlock Text="Type a tag and press Enter. Separate several with commas."
                                   FontSize="11" Foreground="{DynamicResource Brush.TextFaint}" Margin="0,2,0,12" TextWrapping="Wrap"/>

                        <!-- License -->
                        <StackPanel Visibility="{Binding ShowLicense, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="LICENSE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding LicenseTitle}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextUnknown}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LicenseRiskKey}" Value="Free">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextOk}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LicenseRiskKey}" Value="Conditions">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextWarn}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LicenseRiskKey}" Value="Restricted">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextBad}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding LicenseSource}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                                       TextWrapping="Wrap" Margin="0,1,0,4"/>
                            <TextBlock Text="{Binding LicenseSummary}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <ItemsControl ItemsSource="{Binding Conditions}" Margin="0,0,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <TextBlock Text="{Binding Glyph}" Width="18" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextUnknown}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="ok">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextOk}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="warn">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextWarn}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="bad">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextBad}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Expander Header="License text" Margin="0,0,0,6">
                                <Expander.Style>
                                    <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LicenseText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Expander.Style>
                                <TextBox Text="{Binding LicenseText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         MaxHeight="240" VerticalScrollBarVisibility="Auto" FontSize="11"/>
                            </Expander>

                            <TextBlock Text="Wrong license? Set it by hand:" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                            <ComboBox ItemsSource="{Binding LicenseChoices}" SelectedItem="{Binding SelectedLicenseChoice}"
                                      DisplayMemberPath="Label" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding ScopeText}" FontSize="11" Foreground="{DynamicResource Brush.TextFaint}"
                                       TextWrapping="Wrap" Margin="0,2,0,12"/>
                        </StackPanel>

                        <!-- Readme -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReadmeText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="README" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding ReadmeSource}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                                       TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ReadmeText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     MaxHeight="320" VerticalScrollBarVisibility="Auto" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding ResultCount, StringFormat={}{0:N0} items}"/>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding SelectionText}" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,16,0"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar Width="180" Height="12" Maximum="100"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"/>
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="8,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
