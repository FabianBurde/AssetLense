<Window x:Class="AssetManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        Title="Asset Manager" Width="1280" Height="760" MinWidth="800" MinHeight="420">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="8" LastChildFill="True">
            <Button DockPanel.Dock="Left" Content="Add folder…" Command="{Binding AddFolderCommand}"
                    Padding="12,4" Margin="0,0,6,0"/>
            <Button DockPanel.Dock="Left" Content="Rescan all" Command="{Binding RescanCommand}"
                    Padding="12,4" Margin="0,0,12,0"/>
            <ComboBox DockPanel.Dock="Right" Width="130" Margin="6,0,0,0"
                      ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}"
                      DisplayMemberPath="Label"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" ToolTip="Search by file name or path"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="170" MaxWidth="500"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Grid.Column="0" Margin="8,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" MinHeight="40"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="FOLDERS" FontSize="11" FontWeight="SemiBold"
                           Foreground="#777777" Margin="4,0,0,4"/>

                <TreeView Grid.Row="1" ItemsSource="{Binding Folders}" BorderThickness="1" BorderBrush="#DDDDDD"
                          AllowDrop="True" DragOver="Folders_DragOver" Drop="Folders_Drop">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <DockPanel LastChildFill="True" Margin="0,1" ToolTip="{Binding FullPath}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat={}{0:N0}}"
                                           Foreground="#888888" Margin="12,0,4,0"/>
                                <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                                    <Setter Property="Foreground" Value="#999999"/>
                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <DockPanel.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Rescan" Command="{Binding RescanCommand}"/>
                                        <MenuItem Header="Show in Explorer" Command="{Binding OpenInExplorerCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Remove from library…" Command="{Binding RemoveCommand}"/>
                                    </ContextMenu>
                                </DockPanel.ContextMenu>
                            </DockPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <DockPanel Grid.Row="2" Margin="4,12,0,4" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="+" Width="22" Height="20" Padding="0"
                            Command="{Binding AddTargetCommand}" ToolTip="Add a copy target (e.g. your Godot project)"/>
                    <TextBlock Text="QUICK TARGETS" FontSize="11" FontWeight="SemiBold" Foreground="#777777"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <Grid Grid.Row="3">
                    <ListBox ItemsSource="{Binding QuickTargets}" MaxHeight="230" BorderThickness="1"
                             BorderBrush="#DDDDDD" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2" LastChildFill="True" ToolTip="{Binding TargetPath}">
                                    <Button DockPanel.Dock="Right" Content="Copy here" Padding="8,2" Margin="6,0,0,0"
                                            VerticalAlignment="Center" Command="{Binding CopySelectionCommand}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#777777"/>
                                    </StackPanel>
                                    <DockPanel.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Sort into subfolders by type" IsCheckable="True"
                                                      IsChecked="{Binding SortByType, Mode=TwoWay}"/>
                                            <MenuItem Header="snake_case file names" IsCheckable="True"
                                                      IsChecked="{Binding SnakeCaseNames, Mode=TwoWay}"/>
                                            <Separator/>
                                            <MenuItem Header="Remove target" Command="{Binding RemoveCommand}"/>
                                        </ContextMenu>
                                    </DockPanel.ContextMenu>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Add a folder (e.g. your Godot project) to copy selected assets into it with one click."
                               TextWrapping="Wrap" Margin="6,4" FontSize="11" Foreground="#777777"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding QuickTargets.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <!-- Virtualized thumbnail grid -->
            <ListBox Grid.Column="2" Margin="0,0,8,8"
                     ItemsSource="{Binding Items}" SelectionMode="Extended"
                     SelectionChanged="Grid_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.InputBindings>
                    <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyFilesCommand}"/>
                    <KeyBinding Key="C" Modifiers="Ctrl+Shift" Command="{Binding CopyPathsCommand}"/>
                    <KeyBinding Key="Return" Command="{Binding OpenSelectedCommand}"/>
                </ListBox.InputBindings>

                <ListBox.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Copy files" InputGestureText="Ctrl+C" Command="{Binding CopyFilesCommand}"/>
                        <MenuItem Header="Copy path" InputGestureText="Ctrl+Shift+C" Command="{Binding CopyPathsCommand}"/>
                        <MenuItem Header="Copy to" ItemsSource="{Binding QuickTargets}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Name}"/>
                                    <Setter Property="Command" Value="{Binding CopySelectionCommand}"/>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Show in Explorer" Command="{Binding ShowInExplorerCommand}"/>
                        <MenuItem Header="Open" InputGestureText="Enter" Command="{Binding OpenSelectedCommand}"/>
                    </ContextMenu>
                </ListBox.ContextMenu>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel ItemSize="170,200"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick"/>
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="Item_RightClick"/>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="160" Height="190" Margin="5" CornerRadius="4"
                                BorderThickness="1" BorderBrush="#DDDDDD" Background="#FAFAFA"
                                ToolTip="{Binding RelativePath}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="4" Background="#EEEEEE">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding Extension}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold"
                                               Foreground="#999999">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="6,2">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Details}" FontSize="11" Foreground="#777777"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding ResultCount, StringFormat={}{0:N0} items}"/>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding SelectionText}" Foreground="#666666" Margin="0,0,16,0"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar Width="180" Height="12" Maximum="100"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"/>
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="8,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
