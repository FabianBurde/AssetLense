<Window x:Class="AssetManager.App.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Name" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.WindowText}">
    <StackPanel Margin="16">
        <TextBlock x:Name="LabelText" Margin="0,0,0,6"/>
        <TextBox x:Name="InputBox" Padding="4,3" MaxLength="60"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="14,4" Margin="0,0,8,0"/>
            <Button Content="OK" IsDefault="True" Padding="18,4" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
