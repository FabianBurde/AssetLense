<Window x:Class="AssetManager.App.Views.ExportOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export as zip" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.WindowText}">
    <StackPanel Margin="18">
        <TextBlock x:Name="SummaryText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>

        <Border x:Name="WarningBox" Visibility="Collapsed" Margin="0,12,0,0" Padding="10,8"
                BorderThickness="1" BorderBrush="{DynamicResource Brush.TextWarn}" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Check the licenses first" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextWarn}"/>
                <TextBlock x:Name="WarningText" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource Brush.TextWarn}"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Folder layout" Margin="0,16,0,4" Foreground="{DynamicResource Brush.TextMuted}"/>
        <RadioButton x:Name="KeepFoldersRadio" Content="Keep the original folder structure" IsChecked="True" Margin="0,2"/>
        <RadioButton x:Name="FlatRadio" Content="Flat (all files in one folder)" Margin="0,2"/>
        <RadioButton x:Name="ByTypeRadio" Content="Sorted by type (textures, models, audio, ...)" Margin="0,2"/>

        <TextBlock Text="Options" Margin="0,14,0,4" Foreground="{DynamicResource Brush.TextMuted}"/>
        <CheckBox x:Name="SnakeCheck" Content="Rename files to snake_case" Margin="0,2"/>
        <CheckBox x:Name="LicensesCheck" Content="Include the license and readme files of the source folders" IsChecked="True" Margin="0,2"/>
        <CheckBox x:Name="CreditsCheck" Content="Add a CREDITS.txt listing every asset and its license" IsChecked="True" Margin="0,2"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="14,4" Margin="0,0,8,0"/>
            <Button Content="Choose file…" IsDefault="True" Padding="18,4" Click="Export_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
